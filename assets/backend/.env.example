# ─── Cyborg Backend Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Cyborg Backend
DEBUG=false
HOST=127.0.0.1
PORT=8765

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=******

# ─── Firebase ────────────────────────────────────────────────────────────────
# Path to your Firebase service account JSON file (download from Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
FIREBASE_PROJECT_ID=******

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Leave blank to auto-discover models in the models/ directory
DEFAULT_MODEL_PATH=
DEFAULT_MODEL=qwen2.5-coder-14b
CONTEXT_LENGTH=4096
# Number of GPU layers to offload (-1 = all available)
N_GPU_LAYERS=-1
LLM_SERVER_PORT=1234

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Personal Access Token (set here OR connect via the UI — never hardcoded)
GITHUB_TOKEN=

# ─── Features ────────────────────────────────────────────────────────────────
ENABLE_VOICE=true
ENABLE_VISION=false
ENABLE_WORLD_MONITOR=true
OFFLINE_MODE=false

# ─── Redis (optional) ────────────────────────────────────────────────────────
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
